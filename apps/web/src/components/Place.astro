---
import { Picture } from 'astro:assets';
import { Armchair, Clock, MapPin, Navigation, Phone, Soup, Truck } from 'lucide-react';
import facade from '../assets/photos/facade.jpg';
import bench from '../assets/photos/interior-bench.jpg';
import corner from '../assets/photos/interior-corner.jpg';
import hall from '../assets/photos/interior-hall.jpg';
import windowSeat from '../assets/photos/interior-window.jpg';
import { forint, telHref, timeOfDay } from '../format';
import type { PublicConfig } from '../lib/api';
import { strings } from '../strings';

interface Props {
  config: PublicConfig | null;
}

const { config } = Astro.props;
const { about, orderBlock, contact, info } = strings.menuPage;
const name = config?.name ?? strings.siteName;
const photos = [
  { src: windowSeat, alt: about.photos.window },
  { src: corner, alt: about.photos.corner },
  { src: bench, alt: about.photos.bench },
];
const directions =
  config &&
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${config.name}, ${config.contact.address}`)}`;
---

<section id="rolunk" class="block about" aria-labelledby="about-title">
  <div class="frame about-card" data-reveal>
    <h2 id="about-title" class="orn">{about.title}</h2>
    <p class="about-body">{about.body}</p>
    {
      config && (
        <ul class="about-points">
          <li>
            <Soup size={20} aria-hidden="true" />
            {about.daily}
          </li>
          <li>
            <Truck size={20} aria-hidden="true" />
            {about.delivery(forint(config.pricing.deliveryFee))}
          </li>
          <li>
            <Armchair size={20} aria-hidden="true" />
            {about.dineIn(config.contact.openingHours)}
          </li>
        </ul>
      )
    }
  </div>
  <ul class="gallery">
    {
      photos.map((photo, index) => (
        <li data-reveal style={`--i: ${index}`}>
          <Picture
            src={photo.src}
            alt={photo.alt}
            widths={[400, 640, 960]}
            sizes="(min-width: 900px) 30vw, 78vw"
            formats={['avif', 'webp']}
          />
        </li>
      ))
    }
  </ul>
</section>

{
  config && (
    <section id="rendeles" class="block order-block" aria-labelledby="order-title">
      <Picture
        src={hall}
        alt=""
        class="order-photo"
        widths={[480, 960, 1600]}
        sizes="100vw"
        formats={['avif', 'webp']}
      />
      <div class="frame order-card" data-reveal>
        <span class="frame-corner" aria-hidden="true" />
        <span class="frame-corner" aria-hidden="true" />
        <span class="frame-corner" aria-hidden="true" />
        <span class="frame-corner" aria-hidden="true" />
        <h2 id="order-title" class="block-title">{orderBlock.title}</h2>
        <p class="order-lede">
          {orderBlock.lede(timeOfDay(config.contact.intakeWindow.until))}
        </p>
        <dl class="order-facts">
          <div>
            <dt>{info.intake}</dt>
            <dd class="num">
              {info.intakeValue(
                timeOfDay(config.contact.intakeWindow.from),
                timeOfDay(config.contact.intakeWindow.until),
              )}
            </dd>
          </div>
          <div>
            <dt>{info.deliveryFee}</dt>
            <dd class="num">{info.deliveryFeeValue(forint(config.pricing.deliveryFee))}</dd>
          </div>
          <div>
            <dt>{info.minimum}</dt>
            <dd class="num">{info.minimumValue(forint(config.pricing.minimumOrder))}</dd>
          </div>
        </dl>
        <a class="btn cta-order" href="/megrendeles">
          {strings.menuPage.order}
        </a>
        <p class="order-call">
          {orderBlock.call} <a href={telHref(config.contact.phone)}>{config.contact.phone}</a>
        </p>
      </div>
    </section>
  )
}

{
  config && directions && (
    <section id="elerhetoseg" class="block contact" aria-labelledby="contact-title">
      <div class="frame contact-card" data-reveal>
        <Picture
          src={facade}
          alt={contact.facade}
          class="contact-photo"
          widths={[480, 768, 1200]}
          sizes="(min-width: 900px) 460px, 100vw"
          formats={['avif', 'webp']}
        />
        <div class="contact-body">
          <h2 id="contact-title" class="orn">{contact.title}</h2>
          <dl class="contact-list">
            <div class="contact-item">
              <dt>
                <MapPin size={18} aria-hidden="true" />
                <span class="visually-hidden">{contact.address}</span>
              </dt>
              <dd>{config.contact.address}</dd>
            </div>
            <div class="contact-item">
              <dt>
                <Clock size={18} aria-hidden="true" />
                <span class="visually-hidden">{contact.opening}</span>
              </dt>
              <dd>{config.contact.openingHours}</dd>
            </div>
            <div class="contact-item">
              <dt>
                <Phone size={18} aria-hidden="true" />
                <span class="visually-hidden">{contact.phone}</span>
              </dt>
              <dd>
                <a href={telHref(config.contact.phone)}>{config.contact.phone}</a>
              </dd>
            </div>
          </dl>
          <a class="btn contact-directions" href={directions} target="_blank" rel="noopener">
            <Navigation size={18} aria-hidden="true" />
            {contact.directions}
          </a>
        </div>
      </div>
    </section>
  )
}

<footer class="site-foot">
  <p>{strings.menuPage.footer(new Date().getFullYear(), name)}</p>
  {config && <p>{config.contact.address}</p>}
</footer>

<script>
  // Blocks below the menu rise in once as they scroll into view. Where IntersectionObserver is
  // missing or the guest asked for less motion, they are simply there: nothing is hidden until
  // this script has said it can show it again.
  const items = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('reveal-ready');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    for (const item of items) observer.observe(item);
  }
</script>
