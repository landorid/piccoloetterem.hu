    ></path>
    <path
      d="M66 163.9l4.3-4.3v-26.3l-4.1-4.1 12.3-4.5v34.9l4.3 4.3H66zm8.4-43.8c-2.2 0-4.1-1.9-4.1-4.1 0-2.2 1.9-4.1 4.1-4.1 2.2 0 4.1 1.9 4.1 4.1 0 2.1-1.9 4.1-4.1 4.1zm35 44.6c-11.3 0-18.8-9.5-18.8-20.2 0-10.3 7.3-20.1 17.5-20.1 8.5 0 10.4 1.5 13.6 3.2v9.7l-7-7c-1.8-1.9-3.6-2.2-6.4-2.2-6.8 0-7.6 8.6-7.6 14.5 0 13.2 3 18 10.3 18 4.5 0 6.8-1.8 8.4-3.6l2.4 2.4c-3.4 3.3-6.9 5.3-12.4 5.3zm38.3 0c-11.3 0-18.8-9.5-18.8-20.2 0-10.3 7.3-20.1 17.5-20.1 8.5 0 10.4 1.5 13.6 3.2v9.7l-7-7c-1.8-1.9-3.6-2.2-6.4-2.2-6.8 0-7.6 8.6-7.6 14.5 0 13.2 3 18 10.3 18 4.5 0 6.8-1.8 8.4-3.6l2.4 2.4c-3.5 3.3-6.9 5.3-12.4 5.3zm38.9.4c-11 0-19.4-9.6-19.4-20.6 0-11 8.4-20.5 19.4-20.5 11 0 19.4 9.5 19.4 20.5s-8.5 20.6-19.4 20.6zm0-37.8c-7.4 0-9.2 9.4-9.2 17.2 0 7.8 1.8 17.3 9.2 17.3 7.4 0 9.2-9.5 9.2-17.3 0-7.8-1.8-17.2-9.2-17.2zm26.8 36.6l4.2-4.3v-45.4l-4.1-4.1 12.3-4.1v53.6l4.3 4.3h-16.7zm43.8 1.2c-11 0-19.4-9.6-19.4-20.6 0-11 8.4-20.5 19.4-20.5 11 0 19.4 9.5 19.4 20.5s-8.4 20.6-19.4 20.6zm0-37.8c-7.4 0-9.2 9.4-9.2 17.2 0 7.8 1.8 17.3 9.2 17.3 7.4 0 9.2-9.5 9.2-17.3 0-7.8-1.8-17.2-9.2-17.2z"
    ></path>
  </svg>
  {
    config && (
      <p class="masthead-meta">
        {strings.masthead.intake(
          timeOfDay(config.contact.intakeWindow.from),
          timeOfDay(config.contact.intakeWindow.until),
        )}
        <br />
        <a href={telHref(config.contact.phone)}>{config.contact.phone}</a>
      </p>
    )
  }
</header>
