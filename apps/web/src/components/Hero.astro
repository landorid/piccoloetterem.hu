---
import { Phone } from 'lucide-react';
import { telHref, timeOfDay } from '../format';
import type { PublicConfig } from '../lib/api';
import { strings } from '../strings';
import Logo from './Logo.astro';

interface Props {
  config: PublicConfig | null;
}

const { config } = Astro.props;
const { hero, nav } = strings.menuPage;
const name = config?.name ?? strings.siteName;
const intake = config && {
  from: timeOfDay(config.contact.intakeWindow.from),
  until: timeOfDay(config.contact.intakeWindow.until),
};
const links = [
  { href: '#heti-menu', label: nav.menu },
  { href: '#rolunk', label: nav.about },
  { href: '#rendeles', label: nav.order },
  { href: '#elerhetoseg', label: nav.contact },
];
---

<header class="site-head">
  <a class="site-logo" href="/"><Logo label={name} /></a>
  <nav class="site-nav" aria-label={nav.label}>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  {
    config && (
      <a
        class="site-call"
        href={telHref(config.contact.phone)}
        aria-label={nav.call(config.contact.phone)}
      >
        <Phone size={18} aria-hidden="true" />
        <span class="num">{config.contact.phone}</span>
      </a>
    )
  }
</header>
<section class="hero" aria-labelledby="hero-title">
  <p class="hero-eyebrow">{name} · {hero.place}</p>
  <h1 id="hero-title" class="hero-title">{hero.title}</h1>
  {intake && <p class="hero-lede">{hero.lede(intake.until)}</p>}
  {intake && <p class="hero-fact num">{hero.intake(intake.from, intake.until)}</p>}
</section>
