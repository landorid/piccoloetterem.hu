---
import '@fontsource-variable/jost';
import jostLatinExt from '@fontsource-variable/jost/files/jost-latin-ext-wght-normal.woff2?url';
import jostLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import Hero from '../components/Hero.astro';
import { MenuPage, menuSectionId } from '../components/MenuPage';
import Place from '../components/Place.astro';
import Layout from '../layouts/Layout.astro';
import { apiOrigin, createWebApi, loadPublicConfig, type PublicConfig } from '../lib/api';
import { strings } from '../strings';
import '../styles/order.css';
import '../styles/menu.css';

// The public config is baked in at build time, as on /megrendeles (see megrendeles.astro).
const baseUrl = apiOrigin();
let config: PublicConfig | null = null;
if (baseUrl) {
  const api = createWebApi(baseUrl, (input, init) =>
    fetch(input, { ...init, signal: AbortSignal.timeout(10_000) }),
  );
  try {
    config = await loadPublicConfig(api);
  } catch (error) {
    throw new Error(`GET ${baseUrl}/api/config/public failed`, { cause: error });
  }
}
---

<Layout
  title={strings.menuPage.meta.title}
  description={strings.menuPage.meta.description}
  apiOrigin={baseUrl}
>
  {/* The page is set in Jost; the hero needs both subsets (the Hungarian long accents are latin-ext). */}
  {
    [jostLatin, jostLatinExt].map((href) => (
      <link slot="head" rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
    ))
  }
  <div class="menu-site">
    <Hero config={config} />
    <main class="page menu-page" id={menuSectionId}>
      <MenuPage client:load initial={{ config }} />
    </main>
    <Place config={config} />
  </div>
</Layout>
