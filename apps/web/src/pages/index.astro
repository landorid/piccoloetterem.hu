---
import { Contact, DeliveryCard, Hours } from '../components/Landing';
import Logo from '../components/Logo.astro';
import { MenuPage } from '../components/MenuPage';
import Layout from '../layouts/Layout.astro';
import { apiOrigin, createWebApi, loadPublicConfig, type PublicConfig } from '../lib/api';
import { strings } from '../strings';
import '../styles/order.css';
import '../styles/menu.css';
import '../styles/fonts.css';
import '../styles/landing.css';

// The public config is baked in at build time, as on /megrendeles (see megrendeles.astro).
const baseUrl = apiOrigin();
let config: PublicConfig | null = null;
if (baseUrl) {
  const api = createWebApi(baseUrl, (input, init) =>
    fetch(input, { ...init, signal: AbortSignal.timeout(10_000) }),
  );
  try {
    config = await loadPublicConfig(api);
  } catch (error) {
    throw new Error(`GET ${baseUrl}/api/config/public failed`, { cause: error });
  }
}

const { landing: text } = strings;
const orderHref = '/megrendeles';
const name = config?.name ?? strings.siteName;

/** `photos/<name>-600.jpg` and `-1080.jpg`, made by scripts/photos.sh. */
const photo = (file: string) => ({
  src: `/photos/${file}-1080.jpg`,
  srcset: `/photos/${file}-600.jpg 600w, /photos/${file}-1080.jpg 1080w`,
});
const gallery = [
  { file: 'terem-hosszu', alt: text.photos.hall },
  { file: 'terem-boxok', alt: text.photos.booths },
  { file: 'terem-ora', alt: text.photos.clock },
  { file: 'bejarat', alt: text.photos.entrance },
];
---

<Layout
  title={strings.menuPage.meta.title}
  description={strings.menuPage.meta.description}
  apiOrigin={baseUrl}
  bodyClass="landing"
  themeColor="#e3e7d9"
>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/poppins-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600-latin.woff2" as="font" type="font/woff2" crossorigin />
  </Fragment>

  <header class="lp-header">
    <a class="lp-logo" href="/"><Logo label={name} /></a>
    <nav class="lp-nav" aria-label={text.nav.label}>
      <a class="lp-link" href="#heti-menu">{text.nav.menu}</a>
      <a class="lp-link" href="#etterem">{text.nav.restaurant}</a>
      <a class="lp-link" href="#elerhetoseg">{text.nav.contact}</a>
      <a class="lp-cta" href={orderHref}>{text.nav.order}</a>
    </nav>
  </header>

  <!-- Blocks in phone order; landing.css places them in two columns on a wide screen. -->
  <main class="lp-main">
    <img
      class="lp-photo lp-hero"
      data-area="hero"
      {...photo('terem-ablak')}
      sizes="(min-width: 900px) 560px, 100vw"
      alt={text.photos.window}
      width="1080"
      height="1440"
      fetchpriority="high"
    />
    <p class="lp-lede" data-area="lede">{text.lede}</p>
    <MenuPage client:load initial={{ config }} />
    {config && <DeliveryCard config={config} orderHref={orderHref} />}
    <section class="lp-section lp-about" id="etterem" data-area="about" aria-labelledby="lp-about">
      <h2 id="lp-about">{text.about.title}</h2>
      <p>{text.about.body}</p>
    </section>
    {config && <Hours config={config} />}
    <div class="lp-gallery" data-area="gallery">
      {
        gallery.map(({ file, alt }) => (
          <img
            class="lp-photo"
            {...photo(file)}
            sizes="(min-width: 900px) 270px, 50vw"
            alt={alt}
            width="1080"
            height="1440"
            loading="lazy"
          />
        ))
      }
    </div>
    {config && <Contact config={config} />}
  </main>
</Layout>

<script>
  import { masonry } from '../lib/masonry';

  const grid = document.querySelector<HTMLElement>('.lp-main');
  if (grid) masonry(grid);
</script>
