# Copy to .env and fill in. Never commit .env.
# Worker secrets are set with `wrangler secret put <NAME>`, not from this file.

# Neon Postgres connection string (via Hyperdrive in production).
DATABASE_URL=

# Which RestaurantConfig instance this deployment serves.
RESTAURANT=piccolo

# Clerk — staff authentication only. Customers never enter Clerk.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The Clerk organization that represents this restaurant's staff.
CLERK_ORG_ID=

# Amazon SES — transactional email (order confirmation).
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Sentry error tracking DSN.
SENTRY_DSN=

# 1 = log emails instead of sending them. Keep 1 outside production.
EMAIL_DRY_RUN=1
