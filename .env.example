# Copy to .env and fill in. Never commit .env.
# Worker secrets are set with `wrangler secret put <NAME>`, not from this file. `wrangler dev` reads
# its local secrets (DATABASE_URL, SENTRY_DSN, CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY, CLERK_JWT_KEY,
# CLERK_ORG_ID) from apps/api/.dev.vars; see apps/api/README.md and apps/api/.dev.vars.example.
# The admin dev server reads VITE_* from this file (vite envDir is the repo root).

# Neon Postgres connection string (via Hyperdrive in production). In development use the
# branch's *pooled* URL (host contains `-pooler`); `pnpm db:migrate` derives the direct URL from
# it by dropping `-pooler`. A plain local postgres:// URL works too. See packages/db/README.md.
DATABASE_URL=

# Which RestaurantConfig instance this deployment serves.
RESTAURANT=piccolo

# Clerk — staff authentication only. Customers never enter Clerk.
# API Worker (also copy into apps/api/.dev.vars). Never put the secret key in a VITE_ variable.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# PEM public key (Dashboard → API keys → Show JWT public key). Networkless session verification.
# Quote the value; it is multi-line. Example: CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n…\n-----END PUBLIC KEY-----"
CLERK_JWT_KEY=
# The Clerk organization that represents this restaurant's staff. Membership is the only role.
CLERK_ORG_ID=

# Admin SPA. Same publishable key and organization id as above. Baked into the admin build.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_ORG_ID=
# API origin the admin calls. Local `pnpm dev` defaults to http://localhost:8787 when this is empty.
# Set it for any non-local admin build (https://api.<domain>).
VITE_API_URL=
# API origin the public site calls (apps/web reads this file too: its envDir is the repo root).
# /megrendeles reads GET /api/config/public at build time (baked into the page) and the browser
# calls GET /api/menu on load, so the origin is inlined into the build. Local `pnpm dev` defaults
# to http://localhost:8787 when this is empty; a build without it renders the page without the
# API. Set it for any non-local web build (https://api.<domain>).
PUBLIC_API_URL=

# Amazon SES — transactional email (order confirmation).
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Sentry error tracking DSN.
SENTRY_DSN=

# Deployment environment, also the Sentry environment: development | staging | production.
# The Worker gets it from [vars] in apps/api/wrangler.toml, not from this file.
ENVIRONMENT=development

# 1 = log emails instead of sending them. Keep 1 outside production.
EMAIL_DRY_RUN=1
